<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="600" prefWidth="500" spacing="15"
      xmlns="http://javafx.com/javafx/24.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="triplej.banco.Controllers.VistaAdmin.FormularioEmpleadoController"
      styleClass="formulario-root">

    <padding>
        <Insets top="20" right="30" bottom="20" left="30" />
    </padding>

    <Label text="Registrar Nuevo Empleado" fx:id="lblTituloFormulario" styleClass="titulo-form" />

    <Separator styleClass="form-separator" />

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" styleClass="form-scroll">
        <content>
            <VBox spacing="15" styleClass="form-content">

                <!-- Sección: Datos personales -->
                <Label text="Datos Personales" styleClass="section-title" />

                <HBox spacing="10">
                    <VBox spacing="5">
                        <Label text="Nombre:*" />
                        <TextField fx:id="txtNombre" promptText="Ej: Carlos" styleClass="input-field" />
                    </VBox>
                    <VBox spacing="5">
                        <Label text="Apellido:*" />
                        <TextField fx:id="txtApellido" promptText="Ej: López" styleClass="input-field" />
                    </VBox>
                </HBox>

                <VBox spacing="5">
                    <Label text="Cédula:*" />
                    <TextField fx:id="txtCedula" promptText="Ej: 1234567890" styleClass="input-field" />
                </VBox>

                <VBox spacing="5">
                    <Label text="Teléfono:*" />
                    <TextField fx:id="txtTelefono" promptText="Ej: 3001234567" styleClass="input-field" />
                </VBox>

                <HBox spacing="10">
                    <VBox spacing="5">
                        <Label text="Ciudad:*" />
                        <TextField fx:id="txtCiudad" promptText="Ej: Armenia" styleClass="input-field" />
                    </VBox>

                    <VBox spacing="5">
                        <Label text="País:*" />
                        <TextField fx:id="txtPais" promptText="Ej: Colombia" styleClass="input-field" />
                    </VBox>
                </HBox>

                <Separator styleClass="form-separator" />

                <!-- Sección: Datos de acceso -->
                <Label text="Datos de Acceso" styleClass="section-title" />

                <VBox spacing="5">
                    <Label text="Correo Electrónico:*" />
                    <TextField fx:id="txtCorreo" promptText="Ej: carlos@banco.com" styleClass="input-field" />
                </VBox>

                <VBox spacing="5">
                    <Label text="Contraseña:*" />
                    <PasswordField fx:id="txtPassword" promptText="Mínimo 6 caracteres" styleClass="input-field" />
                </VBox>

                <VBox spacing="5">
                    <Label text="Confirmar Contraseña:*" />
                    <PasswordField fx:id="txtConfirmarPassword" styleClass="input-field" />
                </VBox>

                <Separator styleClass="form-separator" />

                <!-- Datos laborales -->
                <Label text="Datos Laborales" styleClass="section-title" />

                <VBox spacing="5">
                    <Label text="Cargo:*" />
                    <TextField fx:id="txtCargo" promptText="Ej: Cajero" styleClass="input-field" />
                </VBox>

                <VBox spacing="5">
                    <Label text="Salario:*" />
                    <TextField fx:id="txtSalario" promptText="Ej: 2500000" styleClass="input-field" />
                </VBox>

                <VBox spacing="5">
                    <Label text="Departamento:*" />
                    <ComboBox fx:id="cmbDepartamento"
                              promptText="Seleccione un departamento"
                              styleClass="input-field" />
                </VBox>

                <Label text="Fotografía del Empleado" styleClass="section-title" />

                <VBox alignment="CENTER" spacing="15">
                    <StackPane prefHeight="200" prefWidth="200" styleClass="image-container">
                        <ImageView fx:id="imgEmpleado"
                                   fitHeight="220" fitWidth="180"
                                   preserveRatio="true">
                            <image>
                                <Image url="@../../Images/avatar.png" />
                            </image>
                        </ImageView>
                    </StackPane>

                    <Button text="Cargar Imagen" onAction="#onCargarImagen" styleClass="btn-load" />
                </VBox>

            </VBox>
        </content>
    </ScrollPane>

    <HBox alignment="CENTER" spacing="15" styleClass="form-buttons">
        <Button text="Guardar" defaultButton="true" onAction="#onGuardar" styleClass="btn-save" />
        <Button text="Cancelar" onAction="#onCancelar" styleClass="btn-cancel" />
    </HBox>

</VBox>