<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Rectangle2D?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="804.0" prefWidth="1234.0" styleClass="table-root" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="triplej.banco.Controllers.VistaAdmin.TablaEmpleadosController">

    <children>
        <AnchorPane fx:id="vistaTabla" layoutX="42.0" layoutY="14.0" prefHeight="654.0" prefWidth="1154.0">

            <children>

                <!-- Tabla -->
                <TableView fx:id="tablaEmpleados" layoutX="14.0" layoutY="61.0" prefHeight="470.0" prefWidth="1101.0" styleClass="table-view">

                    <columns>
                        <TableColumn fx:id="colNombre" styleClass="table-column" text="Nombre" />
                        <TableColumn fx:id="colApellido" styleClass="table-column" text="Apellido" />
                        <TableColumn fx:id="colDocumento" styleClass="table-column" text="Documento" />
                        <TableColumn fx:id="colTelefono" styleClass="table-column" text="Telefono" />
                        <TableColumn fx:id="colCorreo" styleClass="table-column" text="Correo" />
                        <TableColumn fx:id="colCargo" styleClass="table-column" text="Cargo" />
                        <TableColumn fx:id="colDepartamento" styleClass="table-column" text="Departamento" />
                        <TableColumn fx:id="colCiudad" styleClass="table-column" text="Ciudad" />
                        <TableColumn fx:id="colSalario" styleClass="table-column" text="Salario" />
                    </columns>

                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>

                </TableView>

                <!-- Buscador -->
                <TextField fx:id="txtBuscar" layoutX="29.0" layoutY="14.0" prefHeight="31.0" prefWidth="481.0" promptText="Buscar..." styleClass="search-field" />

                <!-- Botones -->
                <Button layoutX="66.0" layoutY="562.0" mnemonicParsing="false" onAction="#editarEmpleado" prefHeight="42.0" prefWidth="196.0" styleClass="btn-edit" text="Editar" />

                <Button layoutX="66.0" layoutY="633.0" mnemonicParsing="false" onAction="#eliminarEmpleado" prefHeight="42.0" prefWidth="196.0" styleClass="btn-delete" text="Eliminar" />

                <!-- Imagen del empleado -->
                <AnchorPane layoutX="653.0" layoutY="536.0" prefHeight="166.0" prefWidth="200.0" styleClass="image-container">
               <children>
                        <ImageView fx:id="imgEmpleado" fitHeight="154.0" fitWidth="180.0" layoutX="10.0" layoutY="6.0" pickOnBounds="true" preserveRatio="true">
                     <viewport>
                        <Rectangle2D />
                     </viewport></ImageView>
               </children>
                </AnchorPane>

            </children>
        </AnchorPane>

        <!-- Panel de edición con overlay -->
        <AnchorPane fx:id="vistaEdicion" layoutX="30.0" layoutY="43.0" prefHeight="703.0" prefWidth="1167.0" styleClass="edit-overlay" visible="false">

            <children>

                <AnchorPane layoutX="314.0" layoutY="30.0" prefHeight="643.0" prefWidth="442.0" styleClass="edit-panel">

                    <children>

                        <Label layoutX="80.0" layoutY="56.0" text="Nombre:*" />
                        <TextField fx:id="txtNombre" layoutX="167.0" layoutY="52.0" styleClass="input-field" />

                        <Label layoutX="80.0" layoutY="98.0" text="Apellido:*" />
                        <TextField fx:id="txtApellido" layoutX="167.0" layoutY="94.0" styleClass="input-field" />

                        <Label layoutX="84.0" layoutY="178.0" text="Cédula:*" />
                        <TextField fx:id="txtCedula" editable="false" layoutX="167.0" layoutY="174.0" prefHeight="17.0" prefWidth="149.0" styleClass="input-field" />

                        <Label layoutX="79.0" layoutY="258.0" text="Teléfono:*" />
                        <TextField fx:id="txtTelefono" layoutX="167.0" layoutY="254.0" styleClass="input-field" />

                        <Label layoutX="79.0" layoutY="216.0" text="Ciudad:*" />
                        <TextField fx:id="txtCiudad" layoutX="167.0" layoutY="212.0" styleClass="input-field" />

                        <Label layoutX="27.0" layoutY="138.0" text="Correo Electrónico:*" />
                        <TextField fx:id="txtCorreo" layoutX="167.0" layoutY="134.0" styleClass="input-field" />

                        <Label layoutX="87.0" layoutY="339.0" text="Cargo:*" />
                        <TextField fx:id="txtCargo" layoutX="164.0" layoutY="335.0" styleClass="input-field" />

                        <Label layoutX="89.0" layoutY="295.0" text="Salario:*" />
                        <TextField fx:id="txtSalario" layoutX="167.0" layoutY="291.0" styleClass="input-field" />

                        <Label layoutX="56.0" layoutY="413.0" text="Departamento:*" />
                        <ComboBox fx:id="cmbDepartamento" layoutX="163.0" layoutY="409.0" promptText="Seleccione un departamento" styleClass="input-field" />

                        <Label layoutX="72.0" layoutY="373.0" text="Contraseña:*" />
                        <PasswordField fx:id="txtContrasenia" layoutX="167.0" layoutY="369.0" styleClass="input-field" />

                        <TextField fx:id="txtContraseniaVisible" layoutX="167.0" layoutY="369.0" managed="false" styleClass="input-field" visible="false" />

                        <CheckBox fx:id="chkMostrarContrasenia" layoutX="333.0" layoutY="373.0" mnemonicParsing="false" onAction="#mostrarContrasenia" />

                        <!-- Botones -->
                        <Button layoutX="64.0" layoutY="524.0" mnemonicParsing="false" onAction="#cancelarEdicion" prefHeight="42.0" prefWidth="125.0" styleClass="btn-cancel" text="Cancelar" />

                        <Button layoutX="232.0" layoutY="524.0" mnemonicParsing="false" onAction="#guardarEdicion" prefHeight="42.0" prefWidth="125.0" styleClass="btn-save" text="Aceptar" />

                    </children>
                </AnchorPane>

            </children>
        </AnchorPane>
    </children>
</AnchorPane>
