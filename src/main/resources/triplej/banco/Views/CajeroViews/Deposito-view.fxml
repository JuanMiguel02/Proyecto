<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" styleClass="ventana-operacion" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="triplej.banco.Controllers.VistaCajero.DepositoController">

    <VBox alignment="CENTER" layoutX="138.0" layoutY="105.0" spacing="15" styleClass="panel-operacion">

        <Label styleClass="titulo-operacion" text="Depósito de dinero" />

        <Label fx:id="lblCuenta" styleClass="texto-operacion" text="Cuenta: " />

        <TextField fx:id="txtMonto" promptText="Ingrese monto a depositar" styleClass="campo-operacion" />

        <Button onAction="#onConfirmarDeposito" styleClass="boton-principal" text="Confirmar Depósito" />

        <Button onAction="#onCancelar" styleClass="boton-secundario" text="Cancelar" />

    </VBox>

</AnchorPane>
