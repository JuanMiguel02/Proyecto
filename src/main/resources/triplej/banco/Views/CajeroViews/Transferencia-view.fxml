<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="450.0" prefWidth="600.0" styleClass="ventana-operacion" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="triplej.banco.Controllers.VistaCajero.TransferenciaController">

    <VBox alignment="CENTER" layoutX="150.0" layoutY="107.0" spacing="15" styleClass="panel-operacion">

        <Label styleClass="titulo-operacion" text="Transferencia de dinero" />

        <Label fx:id="lblCuenta" styleClass="texto-operacion" text="Cuenta origen:" />

        <TextField fx:id="txtCuentaDestino" promptText="Número de cuenta destino" styleClass="campo-operacion" />

        <TextField fx:id="txtCuentaDestinoConfirmacion" promptText="Confirme número de cuenta destino" styleClass="campo-operacion" />

        <TextField fx:id="txtMonto" promptText="Ingrese monto a transferir" styleClass="campo-operacion" />

        <Button onAction="#onConfirmarTransferencia" styleClass="boton-principal" text="Confirmar Transferencia" />

        <Button onAction="#onCancelar" styleClass="boton-secundario" text="Cancelar" />

    </VBox>

</AnchorPane>
