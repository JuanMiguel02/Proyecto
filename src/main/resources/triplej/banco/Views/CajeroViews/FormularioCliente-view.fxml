<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox prefHeight="644.0" prefWidth="883.0" spacing="15"
      xmlns="http://javafx.com/javafx/24.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="triplej.banco.Controllers.VistaCajero.FormularioClienteController"
      styleClass="formulario-root">

    <padding>
        <Insets bottom="20" left="30" right="30" top="20" />
    </padding>

    <children>
        <Label text="Registrar Nuevo Cliente" fx:id="lblTituloFormulario" styleClass="titulo-form" />
        <Separator styleClass="form-separator" />

        <ScrollPane fitToWidth="true" prefHeight="1225.0" VBox.vgrow="ALWAYS" styleClass="form-scroll">
            <content>
                <VBox spacing="15" styleClass="form-content">

                    <!-- Tipo de cliente -->
                    <VBox spacing="5" styleClass="form-group">
                        <Label text="Tipo de Cliente:*" />
                        <ComboBox fx:id="cmbTipoCliente"
                                  onAction="#onTipoClienteSeleccionado"
                                  promptText="Seleccione tipo de cliente"
                                  styleClass="input-field" />
                    </VBox>

                    <!-- Datos Persona Natural -->
                    <VBox fx:id="datosPersonaNatural" spacing="10" styleClass="form-section">
                        <Label text="Datos Personales" fx:id="lblDatosPersonales" styleClass="section-title" />
                        <VBox spacing="5">
                            <Label text="Nombre:*" />
                            <TextField fx:id="txtNombre" promptText="Ej: Juan" styleClass="input-field" />
                        </VBox>
                        <VBox spacing="5">
                            <Label text="Apellido:*" />
                            <TextField fx:id="txtApellido" promptText="Ej: Pérez" styleClass="input-field" />
                        </VBox>
                    </VBox>

                    <!-- Persona Jurídica -->
                    <VBox fx:id="datosPersonaJuridica" managed="false" visible="false" spacing="10" styleClass="form-section">
                        <Label text="Datos Empresa" styleClass="section-title" />
                        <VBox spacing="5">
                            <Label text="Razón Social:*" />
                            <TextField fx:id="txtRazonSocial" promptText="Ej: Compañía ABC S.A." styleClass="input-field" />
                        </VBox>
                        <VBox spacing="5">
                            <Label text="Representante Legal:*" />
                            <TextField fx:id="txtRepresentante" promptText="Ej: Carlos Ruiz" styleClass="input-field" />
                        </VBox>
                        <VBox spacing="5">
                            <Label text="Tipo de Empresa:*" />
                            <TextField fx:id="txtTipoEmpresa" promptText="Ej: Sociedad Anónima" styleClass="input-field" />
                        </VBox>
                    </VBox>

                    <!-- Documento -->
                    <Label text="Tipo de Documento:*" />
                    <ComboBox fx:id="cmbDocumento" promptText="Seleccione un tipo de documento" styleClass="input-field" />

                    <VBox spacing="5">
                        <Label text="Número de Documento:*" />
                        <TextField fx:id="txtNumDocumento" promptText="Ej: 1234567890" styleClass="input-field" />
                    </VBox>

                    <VBox spacing="5">
                        <Label text="Teléfono:*" />
                        <TextField fx:id="txtTelefono" promptText="Ej: 3001234567" styleClass="input-field" />
                    </VBox>

                    <HBox spacing="10">
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Ciudad:*" />
                            <TextField fx:id="txtCiudad" promptText="Ej: Armenia" styleClass="input-field" />
                        </VBox>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="País:*" />
                            <TextField fx:id="txtPais" promptText="Ej: Colombia" styleClass="input-field" />
                        </VBox>
                    </HBox>

                    <Separator styleClass="form-separator" />

                    <!-- Datos de Acceso -->
                    <Label text="Datos de Acceso" styleClass="section-title" />

                    <VBox spacing="5">
                        <Label text="Correo Electrónico:*" />
                        <TextField fx:id="txtCorreo" promptText="Ej: correo@banco.com" styleClass="input-field" />
                    </VBox>
                    <VBox spacing="5">
                        <Label text="Contraseña:*" />
                        <PasswordField fx:id="txtPassword" promptText="Mínimo 6 caracteres" styleClass="input-field" />
                    </VBox>
                    <VBox spacing="5">
                        <Label text="Confirmar Contraseña:*" />
                        <PasswordField fx:id="txtConfirmarPassword" styleClass="input-field" />
                    </VBox>

                    <Separator styleClass="form-separator" />

                    <!-- Datos Cuenta -->
                    <Label text="Datos de Cuenta" styleClass="section-title" />

                    <Label text="Tipo de Cuenta:*" />
                    <ComboBox fx:id="cmbCuenta"
                              promptText="Seleccione un tipo de cuenta"
                              onAction="#onTipoCuentaSeleccionado"
                              styleClass="input-field" />

                    <VBox spacing="5">
                        <Label text="Saldo Inicial:*" />
                        <TextField fx:id="txtSaldo" promptText="Ej: 2500000" styleClass="input-field" />
                    </VBox>

                    <VBox fx:id="campoSobregiro" spacing="5" visible="false" managed="false">
                        <Label text="Sobregiro Disponible:" />
                        <TextField fx:id="txtSobregiro" promptText="Ej: 500000" styleClass="input-field" />
                    </VBox>

                    <Separator styleClass="form-separator" />

                    <!-- Imagen -->
                    <Label text="Fotografía Cliente" styleClass="section-title" />

                    <VBox alignment="CENTER" spacing="15">
                        <StackPane prefHeight="200" prefWidth="200" styleClass="image-container">
                            <ImageView fx:id="imgCliente"
                                       fitHeight="310" fitWidth="198"
                                       pickOnBounds="true" preserveRatio="true">
                                <image>
                                    <Image url="@../../Images/avatar.png" />
                                </image>
                            </ImageView>
                        </StackPane>

                        <Button text="Cargar Imagen"
                                onAction="#onCargarImagen"
                                styleClass="btn-load" />
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>

        <!-- Botones -->
        <HBox alignment="CENTER" spacing="15" styleClass="form-buttons">
            <Button defaultButton="true" onAction="#onRegistrar" text="Guardar" styleClass="btn-save" />
            <Button onAction="#cancelar" text="Cancelar" styleClass="btn-cancel" />
        </HBox>

    </children>
</VBox>
