<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="856.0" prefWidth="1503.0" styleClass="cajero-root" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="triplej.banco.Controllers.VistaCajero.CajeroController">

    <!-- Barra superior -->
    <top>
        <HBox prefHeight="50.0" styleClass="cajero-top-bar" BorderPane.alignment="CENTER">
            <children>
                <Label styleClass="cajero-top-title" text="UQ Bank">
                    <HBox.margin>
                        <Insets left="20" top="10" />
                    </HBox.margin>
                    <font>
                        <Font size="24" />
                    </font>
                </Label>
            </children>
        </HBox>
    </top>

    <!-- Menú lateral -->
    <left>
        <AnchorPane prefWidth="245" styleClass="cajero-sidebar" BorderPane.alignment="CENTER">
            <children>
                <ImageView fitHeight="150.0" fitWidth="200.0" layoutX="52.0" layoutY="25.0" pickOnBounds="true" preserveRatio="true" styleClass="cajero-avatar">
                    <image>
                        <Image url="@../../Images/avatar.png" />
                    </image>
                </ImageView>

                <Label alignment="CENTER" layoutX="34.0" layoutY="190.0" prefHeight="27.0" prefWidth="186.0" styleClass="cajero-sidebar-text" text="Bienvenido," textAlignment="CENTER">
                    <font>
                        <Font size="18" />
                    </font>
                </Label>

                <Label fx:id="lblNombre" alignment="CENTER" layoutX="28.0" layoutY="220.0" prefHeight="31.0" prefWidth="190.0" styleClass="cajero-sidebar-text" textAlignment="CENTER">
                    <font>
                        <Font size="18" />
                    </font>
                </Label>

                <Line endX="100" layoutX="125.0" layoutY="286.0" startX="-100" styleClass="cajero-line" />

                <Button fx:id="btnInicio" layoutX="23.0" layoutY="312.0" onAction="#mostrarInicio" prefHeight="37" prefWidth="166" styleClass="cajero-btn-sidebar" text="Inicio" />
                <Button fx:id="btnTransacciones" layoutX="23.0" layoutY="375.0" onAction="#onGenerarReporte" prefHeight="37" prefWidth="166" styleClass="cajero-btn-sidebar" text="Generar Reporte Cliente" />
                <Button fx:id="btnSalir" layoutX="52.0" layoutY="596.0" onAction="#volverMenu" prefHeight="32" prefWidth="95" styleClass="cajero-btn-sidebar" text="Salir" />
                <Button layoutX="19.0" layoutY="431.0" onAction="#mostrarFormulario" prefHeight="38.0" prefWidth="189.0" styleClass="cajero-btn-sidebar" text="Agregar un Nuevo Cliente" />
                <Button layoutX="23.0" layoutY="492.0" onAction="#abrirFormularioNuevaCuenta" prefHeight="37" prefWidth="166" styleClass="cajero-btn-sidebar" text="Abrir Nueva Cuenta" />
            </children>
        </AnchorPane>
    </left>

    <!-- Centro: búsqueda + información del cliente + cuentas -->
    <center>
        <StackPane fx:id="contenedorCentro" styleClass="cajero-center-stack" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="30" left="30" right="30" top="30" />
            </padding>

            <!-- Vista de reporte -->
            <AnchorPane fx:id="vistaReporte" maxHeight="711.0" maxWidth="991.0" prefHeight="711.0" prefWidth="991.0" styleClass="cajero-panel-reporte" visible="false" StackPane.alignment="CENTER">
                <children>
                    <VBox alignment="TOP_CENTER" layoutX="58.0" layoutY="41.0" pickOnBounds="false" prefHeight="618.0" prefWidth="950.0" spacing="20" styleClass="cajero-vbox-reporte">

                        <Label styleClass="cajero-label-reporte-title" text="Reporte general de cuenta">
                            <VBox.margin>
                                <Insets bottom="30.0" top="30.0" />
                            </VBox.margin>
                        </Label>

                        <ScrollPane fx:id="scrollPaneReporte" fitToWidth="true" maxHeight="350" prefHeight="300.0" prefWidth="0.0" styleClass="cajero-scrollpane">
                            <content>
                                <TextArea fx:id="txtReporteGeneral" prefHeight="300.0" prefWidth="500.0" styleClass="cajero-textarea-reporte" wrapText="true" />
                            </content>
                            <VBox.margin>
                                <Insets left="50.0" right="50.0" />
                            </VBox.margin>
                        </ScrollPane>

                        <Button fx:id="btnGuardarReporte" onAction="#onGuardarReporte" prefHeight="58.0" prefWidth="180" styleClass="cajero-btn-guardar" text="Guardar">
                            <VBox.margin>
                                <Insets top="100.0" />
                            </VBox.margin>
                        </Button>

                    </VBox>
                </children>
            </AnchorPane>

            <!-- Vista inicio -->
            <AnchorPane fx:id="vistaInicio" prefHeight="759.0" prefWidth="1045.0">
                <children>

                    <!-- Búsqueda -->
                    <HBox alignment="CENTER" layoutX="47.0" layoutY="28.0" prefHeight="25.0" prefWidth="1104.0" spacing="10" styleClass="cajero-hbox-busqueda">
                        <TextField fx:id="txtBusquedaCliente" prefHeight="25.0" prefWidth="757.0" promptText="Ingrese número de documento ó el número de cuenta" styleClass="cajero-textfield-busqueda" />
                        <Button fx:id="btnBuscarCliente" onAction="#buscarCliente" prefHeight="25.0" prefWidth="153.0" styleClass="cajero-btn-busqueda" text="Buscar" />
                    </HBox>

                    <!-- Información del cliente -->
                    <AnchorPane fx:id="panelInfoCliente" layoutX="22.0" layoutY="84.0" prefHeight="438.0" prefWidth="1175.0" styleClass="cajero-panel-cliente">
                        <children>

                            <Label layoutX="274.0" layoutY="126.0" styleClass="cajero-label-cliente" text="Nombre:" />
                            <TextField fx:id="txtNombre" editable="false" layoutX="401.0" layoutY="123.0" prefWidth="250" styleClass="cajero-textfield-cliente" />

                            <Label layoutX="279.0" layoutY="183.0" styleClass="cajero-label-cliente" text="Correo:" />
                            <TextField fx:id="txtCorreo" editable="false" layoutX="401.0" layoutY="179.0" prefWidth="250" styleClass="cajero-textfield-cliente" />

                            <Label layoutX="689.0" layoutY="175.0" styleClass="cajero-label-cliente" text="Teléfono:" />
                            <TextField fx:id="txtTelefono" editable="false" layoutX="827.0" layoutY="179.0" prefHeight="25.0" prefWidth="251.0" styleClass="cajero-textfield-cliente" />

                            <Label layoutX="695.0" layoutY="118.0" styleClass="cajero-label-cliente" text="Ciudad:" />
                            <TextField fx:id="txtCiudad" editable="false" layoutX="833.0" layoutY="114.0" prefHeight="25.0" prefWidth="239.0" styleClass="cajero-textfield-cliente" />

                            <Label layoutX="267.0" layoutY="307.0" styleClass="cajero-label-cliente" text="Cuentas del cliente:" />
                            <ComboBox fx:id="cmbCuentasCliente" layoutX="409.0" layoutY="303.0" prefWidth="250" promptText="Seleccione una cuenta" styleClass="cajero-combobox-cliente" />

                            <Label layoutX="50.0" layoutY="30.0" styleClass="cajero-label-cliente-title" text="Datos del Cliente">
                                <font>
                                    <Font size="36.0" />
                                </font>
                            </Label>

                            <Label layoutX="235.0" layoutY="241.0" styleClass="cajero-label-cliente" text="Tipo de Documento:" />
                            <TextField fx:id="txtTipoDocumento" editable="false" layoutX="401.0" layoutY="237.0" prefHeight="25.0" prefWidth="251.0" styleClass="cajero-textfield-cliente" />

                            <Label layoutX="660.0" layoutY="241.0" styleClass="cajero-label-cliente" text="Número Documento" />
                            <TextField fx:id="txtNumeroDocumento" editable="false" layoutX="827.0" layoutY="237.0" prefHeight="25.0" prefWidth="251.0" styleClass="cajero-textfield-cliente" />

                            <ImageView fx:id="imgFotoCliente" fitHeight="218.0" fitWidth="284.0" layoutX="29.0" layoutY="110.0" pickOnBounds="true" preserveRatio="true" styleClass="cajero-img-cliente">
                                <image>
                                    <Image url="@../../Images/avatar.png" />
                                </image>
                            </ImageView>

                        </children>
                    </AnchorPane>

                    <!-- Botones de operaciones -->
                    <HBox alignment="CENTER" layoutX="165.0" layoutY="568.0" prefHeight="159.0" prefWidth="935.0" spacing="40" styleClass="cajero-hbox-operaciones">
                        <Button fx:id="btnDepositar" onAction="#onDepositar" prefHeight="50" prefWidth="180" styleClass="cajero-btn-operacion" text="Depositar" />
                        <Button fx:id="btnRetirar" prefHeight="50" prefWidth="180" styleClass="cajero-btn-operacion" text="Retirar" />
                        <Button fx:id="btnTransferir" prefHeight="50" prefWidth="180" styleClass="cajero-btn-operacion" text="Transferir" />
                        <Button layoutX="608.0" layoutY="65.0" onAction="#onConsultarSaldo" prefHeight="50" prefWidth="180" styleClass="cajero-btn-operacion" text="Consultar Saldo" />
                    </HBox>
                </children>
            </AnchorPane>
        </StackPane>
    </center>

    <!-- Pie de página -->
    <bottom>
        <HBox prefHeight="84.0" prefWidth="1503.0" styleClass="cajero-bottom-bar" BorderPane.alignment="CENTER" />
    </bottom>

</BorderPane>
