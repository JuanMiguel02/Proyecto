<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Line?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="920.0" prefWidth="1480.0" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="triplej.banco.Controllers.VistaCajero.CajeroController">

    <!--  Barra superior -->
    <top>
        <HBox prefHeight="50.0" style="-fx-background-color: black;" BorderPane.alignment="CENTER">
            <children>
                <Label style="-fx-text-fill: white;" text="UQ Bank">
                    <HBox.margin>
                        <Insets left="20" top="10" />
                    </HBox.margin>
                    <font>
                        <Font size="24" />
                    </font>
                </Label>
            </children>
        </HBox>
    </top>

    <!--  Menú lateral -->
    <left>
        <AnchorPane prefWidth="245" style="-fx-background-color: #C1FFC1;" BorderPane.alignment="CENTER">
            <children>
                <ImageView fitHeight="160" fitWidth="160" layoutX="42" layoutY="20" pickOnBounds="true" preserveRatio="true">
                    <image>

                    </image>
                </ImageView>

                <Label alignment="CENTER" layoutX="34.0" layoutY="190" prefHeight="27.0" prefWidth="186.0" text="Bienvenido," textAlignment="CENTER">
                    <font>
                        <Font size="18" />
                    </font>
                </Label>

                <Label fx:id="lblNombre" alignment="CENTER" layoutX="28" layoutY="220" prefHeight="31" prefWidth="190" textAlignment="CENTER">
                    <font>
                        <Font size="18" />
                    </font>
                </Label>

                <Line endX="100" layoutX="125.0" layoutY="286.0" startX="-100" />

                <Button fx:id="btnInicio" layoutX="39.0" layoutY="349.0" onAction="#mostrarInicio" prefHeight="37" prefWidth="166" text="Inicio" />
                <Button fx:id="btnTransacciones" layoutX="42" layoutY="420" onAction="#onGenerarReporte" prefHeight="37" prefWidth="166" text="Generar Reporte Cliente" />
                <Button fx:id="btnSalir" layoutX="23.0" layoutY="754.0" onAction="#volverMenu" prefHeight="32" prefWidth="95" text="Salir" />
            <Button layoutX="42.0" layoutY="481.0" onAction="#mostrarFormulario" prefHeight="37" prefWidth="166" text="Agregar un Nuevo Cliente" />
            <Button layoutX="39.0" layoutY="541.0" onAction="#abrirFormularioNuevaCuenta" prefHeight="37" prefWidth="166" text="Abrir Nueva Cuenta" />
            <ImageView fitHeight="150.0" fitWidth="200.0" layoutX="52.0" layoutY="25.0" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../../Images/avatar.png" />
               </image>
            </ImageView>
            </children>
        </AnchorPane>
    </left>

    <!--  Centro: búsqueda + información del cliente + cuentas -->
    <center>
        <StackPane fx:id="contenedorCentro" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="30" left="30" right="30" top="30" />
            </padding>
            <AnchorPane fx:id="vistaReporte" maxHeight="711.0" maxWidth="991.0" prefHeight="711.0" prefWidth="991.0" style="-fx-background-color: rgba(255,255,255,0.95);                     -fx-background-radius: 10;                     -fx-border-color: #D0D0D0;                     -fx-border-radius: 10;                     -fx-padding: 30;                     -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 12, 0, 0, 4);" visible="false" StackPane.alignment="CENTER">

                <children>
                    <VBox alignment="TOP_CENTER" layoutX="58.0" layoutY="41.0" pickOnBounds="false" prefHeight="618.0" prefWidth="950.0" spacing="20" style="-fx-border-color: black;">
                        <!-- Título -->
                        <Label style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #333;" text="Reporte general de cuenta">
                     <VBox.margin>
                        <Insets bottom="30.0" top="30.0" />
                     </VBox.margin></Label>

                        <!-- ScrollPane con TextArea -->
                        <ScrollPane fx:id="scrollPaneReporte" fitToWidth="true" maxHeight="350" prefHeight="300.0" prefWidth="0.0" style="-fx-background-color: transparent;                                -fx-border-color: #E0E0E0;                                -fx-border-radius: 8;">
                            <content>
                                <TextArea fx:id="txtReporteGeneral" prefHeight="300.0" prefWidth="500.0" style="-fx-font-size: 14px;" wrapText="true" />
                            </content>
                     <VBox.margin>
                        <Insets left="50.0" right="50.0" />
                     </VBox.margin>
                        </ScrollPane>

                        <!-- Botón Guardar -->
                        <Button fx:id="btnGuardarReporte" onAction="#onGuardarReporte" prefHeight="58.0" prefWidth="180" style="-fx-background-color: #4CAF50;                            -fx-text-fill: white;                            -fx-font-size: 14px;                            -fx-font-weight: bold;                            -fx-background-radius: 8;" text="Guardar">
                     <VBox.margin>
                        <Insets top="100.0" />
                     </VBox.margin></Button>
                    </VBox>
                </children>
            </AnchorPane>
         <AnchorPane fx:id="vistaInicio" prefHeight="802.0" prefWidth="1175.0">
            <children>

                  <!--  Búsqueda -->
                  <HBox alignment="CENTER" layoutX="47.0" layoutY="28.0" prefHeight="25.0" prefWidth="1104.0" spacing="10">
                      <TextField fx:id="txtBusquedaCliente" prefHeight="25.0" prefWidth="757.0" promptText="Ingrese número de documento ó el número de cuenta" />
                      <Button fx:id="btnBuscarCliente" onAction="#buscarCliente" prefHeight="25.0" prefWidth="153.0" text="Buscar" />
                  </HBox>

                  <!--  Información del cliente -->
                  <AnchorPane fx:id="panelInfoCliente" layoutX="22.0" layoutY="84.0" prefHeight="438.0" prefWidth="1175.0" style="-fx-border-color: gray; -fx-border-radius: 10; -fx-background-radius: 10; -fx-background-color: #F5FFF5;">
                      <children>

                          <Label layoutX="274.0" layoutY="126.0" text="Nombre:" />
                          <TextField fx:id="txtNombre" editable="false" layoutX="354.0" layoutY="121.0" prefWidth="250" />

                          <Label layoutX="279.0" layoutY="183.0" text="Correo:" />
                          <TextField fx:id="txtCorreo" editable="false" layoutX="355.0" layoutY="182.0" prefWidth="250" />

                          <Label layoutX="689.0" layoutY="175.0" text="Teléfono:" />
                          <TextField fx:id="txtTelefono" editable="false" layoutX="790.0" layoutY="179.0" prefHeight="25.0" prefWidth="251.0" />

                          <Label layoutX="695.0" layoutY="118.0" text="Ciudad:" />
                          <TextField fx:id="txtCiudad" editable="false" layoutX="790.0" layoutY="114.0" prefHeight="25.0" prefWidth="239.0" />

                          <Label layoutX="267.0" layoutY="307.0" text="Cuentas del cliente:" />
                          <ComboBox fx:id="cmbCuentasCliente" layoutX="392.0" layoutY="303.0" prefWidth="250" promptText="Seleccione una cuenta" />
                     <Label layoutX="50.0" layoutY="30.0" text="Datos del Cliente">
                        <font>
                           <Font size="36.0" />
                        </font>
                     </Label>
                     <Label layoutX="243.0" layoutY="241.0" text="Tipo de Documento:" />
                     <TextField fx:id="txtTipoDocumento" editable="false" layoutX="354.0" layoutY="237.0" prefHeight="25.0" prefWidth="251.0" />
                     <Label layoutX="660.0" layoutY="241.0" text="Número Documento" />
                     <TextField fx:id="txtNumeroDocumento" editable="false" layoutX="790.0" layoutY="237.0" prefHeight="25.0" prefWidth="251.0" />
                     <ImageView fx:id="imgFotoCliente" fitHeight="218.0" fitWidth="284.0" layoutX="29.0" layoutY="110.0" pickOnBounds="true" preserveRatio="true">
                        <image>
                           <Image url="@../../Images/avatar.png" />
                        </image>
                     </ImageView>
                      </children>
                  </AnchorPane>

                  <!-- 🔘 Botones de operaciones -->
                  <HBox alignment="CENTER" layoutX="165.0" layoutY="568.0" prefHeight="159.0" prefWidth="935.0" spacing="40" style="-fx-border-color: black;">
                      <Button fx:id="btnDepositar" onAction="#onDepositar" prefHeight="50" prefWidth="180" text="Depositar" />
                      <Button fx:id="btnRetirar" prefHeight="50" prefWidth="180" text="Retirar" />
                      <Button fx:id="btnTransferir" prefHeight="50" prefWidth="180" text="Transferir" />
                  <Button layoutX="608.0" layoutY="65.0" onAction="#onConsultarSaldo" prefHeight="50" prefWidth="180" text="Consultar Saldo" />
                  </HBox>
            </children>
         </AnchorPane>
        </StackPane>
    </center>

    <!--  Pie de página -->
    <bottom>
        <HBox prefHeight="50" style="-fx-background-color: black;" BorderPane.alignment="CENTER" />
    </bottom>

</BorderPane>
