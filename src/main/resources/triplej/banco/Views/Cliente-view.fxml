<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1280.0"
            xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="triplej.banco.Controllers.ClienteController">

    <!--  BARRA SUPERIOR -->
    <top>
        <HBox prefHeight="60.0" styleClass="barra-superior" BorderPane.alignment="CENTER">
            <children>
                <Label text="UQ Bank" styleClass="titulo-superior">
                    <HBox.margin>
                        <Insets left="30.0" top="15.0" />
                    </HBox.margin>
                </Label>
            </children>
        </HBox>
    </top>

    <!--  PANEL LATERAL IZQUIERDO -->
    <left>
        <AnchorPane prefWidth="270.0" styleClass="panel-lateral" BorderPane.alignment="CENTER">
            <children>

                <ImageView fx:id="imgCliente"
                           fitHeight="130.0" fitWidth="130.0"
                           layoutX="70.0" layoutY="30.0"
                           preserveRatio="true"
                           styleClass="avatar-panel">
                    <image>
                        <Image url="@../Images/avatar.png" />
                    </image>
                </ImageView>

                <Label layoutX="85.0" layoutY="180.0"
                       text="Bienvenido,"
                       styleClass="texto-bienvenida">
                </Label>

                <Label fx:id="lblNombre"
                       alignment="CENTER"
                       layoutX="35.0" layoutY="210.0"
                       prefWidth="200.0"
                       textAlignment="CENTER"
                       styleClass="nombre-cliente">

                </Label>

                <Label layoutX="100.0" layoutY="270.0"
                       text="Cuenta:"
                       styleClass="texto-cuenta">

                </Label>

                <Label fx:id="lblNumCuenta"
                       alignment="CENTER"
                       layoutX="35.0" layoutY="300.0"
                       prefWidth="200.0"
                       textAlignment="CENTER"
                       styleClass="numero-cuenta">
                    <font>
                        <Font size="16.0" />
                    </font>
                </Label>

                <Button fx:id="btnSalir"
                        layoutX="80.0" layoutY="640.0"
                        mnemonicParsing="false"
                        onAction="#volverMenu"
                        prefHeight="36.0" prefWidth="110.0"
                        text="Salir"
                        styleClass="boton-salir">

                </Button>

            </children>
        </AnchorPane>
    </left>

    <!--  CONTENIDO CENTRAL -->
    <center>
        <StackPane styleClass="contenido-central" BorderPane.alignment="CENTER">
            <children>

                <AnchorPane prefHeight="500.0" prefWidth="600.0">

                    <children>
                        <!-- Caja del saldo -->
                        <Label layoutX="225.0" layoutY="100.0"
                               text="Saldo actual:"
                               styleClass="titulo-saldo">
                            <font>
                            </font>
                        </Label>

                        <Label fx:id="lblDinero"
                               alignment="CENTER"
                               layoutX="150.0" layoutY="150.0"
                               prefHeight="120.0" prefWidth="300.0"
                               styleClass="caja-saldo">
                            <font>
                                <Font name="System Bold" size="48.0" />
                            </font>
                        </Label>

                        <!-- ComboBox para elegir cuenta -->
                        <ComboBox fx:id="cmbCuentas"
                                  layoutX="150.0" layoutY="310.0"
                                  prefWidth="300.0"
                                  promptText="Seleccione una cuenta"
                                  styleClass="combo-cuentas" />

                        <!-- Botón transferir -->
                        <Button fx:id="btnTransferir"
                                layoutX="215.0" layoutY="370.0"
                                mnemonicParsing="false"
                                onAction="#onTransferir"
                                prefHeight="55.0" prefWidth="170.0"
                                text="Transferir"
                                styleClass="boton-transferir">
                        </Button>

                    </children>

                </AnchorPane>

            </children>
        </StackPane>
    </center>

    <!--  BARRA INFERIOR -->
    <bottom>
        <HBox prefHeight="50.0" styleClass="barra-inferior"
              BorderPane.alignment="CENTER" />
    </bottom>

</BorderPane>
